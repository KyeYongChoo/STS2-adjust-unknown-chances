<Project Sdk="Microsoft.NET.Sdk">
  <!-- Optional BaseLib integration. Built automatically by ../AdjustUnknownChances.csproj. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <AssemblyName>AdjustUnknownChances.BaseLib</AssemblyName>
    <RootNamespace>AdjustUnknownChances.BaseLibCompat</RootNamespace>
    <OutputPath>../bin/$(Configuration)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <STS2GameDir Condition="'$(STS2GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Slay the Spire 2</STS2GameDir>
    <STS2GameDataDir Condition="'$(STS2GameDataDir)' == ''">$(STS2GameDir)/data_sts2_windows_x86_64</STS2GameDataDir>
    <!-- BaseLib from the Steam Workshop (item 3737335127). Override with -p:BaseLibDll="...". -->
    <BaseLibDll Condition="'$(BaseLibDll)' == ''">$(STS2GameDir)/../../workshop/content/2868840/3737335127/BaseLib/BaseLib.dll</BaseLibDll>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="AdjustUnknownChances">
      <HintPath>../bin/$(Configuration)/AdjustUnknownChances.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BaseLib">
      <HintPath>$(BaseLibDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="sts2">
      <HintPath>$(STS2GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(STS2GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(STS2GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
